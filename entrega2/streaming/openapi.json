{
  "openapi": "3.1.0",
  "info": {
    "title": "PDM - API de anomalias de perda (api-anomalia-perda)",
    "version": "1.1.0",
    "description": "Servico no ar no Cloud Run, us-central1, acesso publico. Recebe as sete features diarias da Gold e devolve grupo, distancia normalizada e is_anomaly, mais o clima do dia (contexto_inmet) quando o pedido traz id_ons e dia."
  },
  "paths": {
    "/v1/predict": {
      "post": {
        "operationId": "predictDaily",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./predict_request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Previsao do modelo, com o clima do dia separado (o clima nao entra no modelo)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./predict_response.schema.json"
                }
              }
            }
          },
          "422": {
            "description": "Entrada invalida"
          },
          "503": {
            "description": "Arquivo do modelo nao carregou. Falha do BigQuery nao gera 503: a previsao sai com contexto_inmet.status = INDISPONIVEL"
          },
          "400": {
            "description": "JSON malformado"
          },
          "413": {
            "description": "Corpo maior que 16 KB"
          }
        }
      }
    },
    "/predict": {
      "post": {
        "operationId": "predictDailyAlias",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./predict_request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Previsao do modelo, com o clima do dia separado (o clima nao entra no modelo)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./predict_response.schema.json"
                }
              }
            }
          },
          "422": {
            "description": "Entrada invalida"
          },
          "503": {
            "description": "Arquivo do modelo nao carregou. Falha do BigQuery nao gera 503: a previsao sai com contexto_inmet.status = INDISPONIVEL"
          },
          "400": {
            "description": "JSON malformado"
          },
          "413": {
            "description": "Corpo maior que 16 KB"
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "status ok quando o arquivo do modelo carregou; sem_modelo quando nao carregou"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api-anomalia-perda-ag2ve5rgla-uc.a.run.app"
    }
  ]
}