{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.1",
        "1.1.0"
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "id_ons": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Opcional. Com dia, permite buscar o clima do dia."
    },
    "dia": {
      "type": "string",
      "format": "date"
    },
    "replay_run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "description": "Opcional. Sem ele, a API usa a execução oficial demo_20261018_01."
    },
    "features": {
      "type": "object",
      "properties": {
        "tipo_usina": {
          "type": "string",
          "enum": [
            "EOLIELETRICA",
            "FOTOVOLTAICA"
          ]
        },
        "mwh_gerado": {
          "type": "number",
          "minimum": 0,
          "maximum": 240000
        },
        "mwh_perdido": {
          "type": "number",
          "minimum": 0,
          "maximum": 240000
        },
        "pct_horas_restricao": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentual 0-100, copiado da Gold sem reescalar; faixa confirmada no BigQuery em 18/10/2026."
        },
        "mw_disponibilidade_media": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "pct_perda": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentual 0-100. A API recusa (422) quando difere em mais de 0,005 de 100*mwh_perdido/(mwh_perdido+mwh_gerado)."
        },
        "fator_capacidade": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "tipo_usina",
        "mwh_gerado",
        "mwh_perdido",
        "pct_horas_restricao",
        "mw_disponibilidade_media",
        "pct_perda",
        "fator_capacidade"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "features"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pdm:api:request:1.1.0"
}
